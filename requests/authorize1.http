### Missing access_token
# Expected: 400 Bad Request
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "method": "GET",
  "path": "/transactions"
}

### Malformed token
# Expected: 401 Unauthorized
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "not-a-jwt",
  "method": "GET",
  "path": "/transactions"
}

### Unsupported method
# Expected: 400 Bad Request
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "OPTIONS",
  "path": "/transactions"
}

### Invalid path format
# Expected: 400 Bad Request
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "GET",
  "path": "transactions"
}

### Malformed JSON
# Expected: 400 Bad Request
POST {{baseUrl}}/authorize
Content-Type: application/json

{"access_token":"{{tokenUser123}}","method":"GET","path":"/transactions"

### Default DENY when no permission matches
# Expected: 200, decision DENY
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "GET",
  "path": "/unmatched/resource"
}

### Wildcard match: one segment
# Expected: 200, decision ALLOW
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser456}}",
  "method": "GET",
  "path": "/wallets/wallet-999"
}

### Wildcard length mismatch
# Expected: 200, decision DENY
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser789}}",
  "method": "POST",
  "path": "/wallets/wallet-456/transactions"
}

### Specificity precedence
# Expected: 200, decision ALLOW if the seeded specific rule and inheritance policy match
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser456}}",
  "method": "GET",
  "path": "/wallets/wallet-789/transactions/txn-abc"
}

### Equal-specificity DENY precedence
# The seed data does not contain a conflicting equal-specificity pair.
# Verify this behavior using the automated unit test; this request alone does not prove precedence.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "GET",
  "path": "/transactions"
}

### Nested inheritance: transaction delete
# Expected: 200, decision DENY under the implemented inheritance policy
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "DELETE",
  "path": "/transactions/txn-999"
}
