@baseUrl = http://localhost:3000

# Replace the placeholder below with a real Auth0 access token (must include the configured
# audience and a `sub` that matches a seeded permission identity, e.g. "user123").
@token = <PASTE_REAL_AUTH0_ACCESS_TOKEN_HERE>

### Health check
# Expected: 200 OK
GET {{baseUrl}}/health
Accept: application/json

### 1. user123 GET /transactions
# Expected: 200, decision ALLOW
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "GET",
  "path": "/transactions"
}

### 2. user123 DELETE /transactions/txn-456
# Expected: 200, decision DENY
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenUser123}}",
  "method": "DELETE",
  "path": "/transactions/txn-456"
}
