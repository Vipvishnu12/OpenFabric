### Malformed token value
# Expected: 401, Authentication failed.
# Additional test data required: No.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "not-a-jwt",
  "method": "GET",
  "path": "/transactions"
}

### Expired token
# Expected: 401, Authentication failed.
# Additional test data required: Real expired Auth0 token.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenExpired}}",
  "method": "GET",
  "path": "/transactions"
}

### Wrong audience token
# Expected: 401, Authentication failed.
# Additional test data required: Real Auth0 token with wrong aud.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{tokenWrongAudience}}",
  "method": "GET",
  "path": "/transactions"
}

