### Browser-style SPA login flow (manual)
# This is the Auth0 request the browser app is expected to trigger using the SPA SDK.
# Use this in a REST client only as a reference; do not paste a secret into frontend code.
GET https://dev-uybuuex2tecljyan.us.auth0.com/authorize?response_type=code&client_id=WjHm3Xvkpe4SpK8bBvF2VbhwwYHZpGM6&redirect_uri=http://localhost:3000&audience=https://auth-service-api&scope=openid%20profile%20email&code_challenge=REPLACE_WITH_PKCE_CODE_CHALLENGE&code_challenge_method=S256

### Auth0 token exchange (for browser code flow)
# This is the code exchange the SPA SDK performs after Auth0 redirects back to the app.
# Replace the code and verifier values with real values from the browser flow.
POST https://dev-uybuuex2tecljyan.us.auth0.com/oauth/token
Content-Type: application/json

{
  "grant_type": "authorization_code",
  "client_id": "WjHm3Xvkpe4SpK8bBvF2VbhwwYHZpGM6",
  "code": "REPLACE_WITH_AUTHORIZATION_CODE",
  "code_verifier": "REPLACE_WITH_CODE_VERIFIER",
  "redirect_uri": "http://localhost:3000"
}

### Auth0 access token request for the API audience
# Use this only as a reference for the browser token acquisition flow.
# The returned token must be for audience https://auth-service-api and must not be an ID token.
POST https://dev-uybuuex2tecljyan.us.auth0.com/oauth/token
Content-Type: application/json

{
  "grant_type": "client_credentials",
  "client_id": "{{client_id}}",
  "client_secret": "{{client_secret}}",
  "audience": "https://auth-service-api"
}

### Health check
# Expected: 200, status ok.
# Additional test data required: No.
GET {{baseUrl}}/health
Accept: application/json

### Assignment example 1
# Expected: 200, decision ALLOW.
# Additional test data required: No.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{token}}",
  "method": "GET",
  "path": "/transactions"
}

