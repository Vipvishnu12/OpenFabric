Content-Type: application/json

{
  "access_token": "{{token}}",
  "method": "GET",
  "path": "/transactions"
}

### Nested inheritance
# Expected: 200, decision DENY for this request because the seeded delete deny on transactions applies to /transactions/{id}.
# Additional test data required: No.
POST {{baseUrl}}/authorize
Content-Type: application/json

{
  "access_token": "{{token}}",
  "method": "DELETE",
  "path": "/transactions/txn-999"
}






